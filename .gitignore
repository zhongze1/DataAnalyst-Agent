# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 环境变量（含 API Key，勿提交）
.env

# 运行时产物：上传的会话数据不入库
data/*
# 但样本数据与其生成脚本必须入库（可复现，且防止误删）
!data/samples/

# 本地服务日志（uvicorn 的 stdout/stderr 重定向产物）
uvicorn.out.log
uvicorn.err.log

# 测试与覆盖率产物
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/

# IDE
.idea/
.vscode/

# AI tool local plans
.codebuddy/
.trae/
