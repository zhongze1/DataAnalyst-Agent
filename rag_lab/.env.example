# RAG 实验配置（RAG-03 起需要；RAG-01/02 阶段不需要任何配置）
#
# ⚠️ 真实 API Key 绝不写进本文件，也绝不提交到 Git：
#    复制本文件为 .env（已被 rag_lab/.gitignore 忽略），Key 只放在 .env 里。
#
# 默认 provider=fake：确定性离线向量，**不懂语义**，只能用来跑通链路与测试。
# 要做真实的检索评估（RAG-04），必须换成 provider=api 并把下面四项填齐。

RAG_LAB_EMBEDDING_PROVIDER=fake

# ---- provider=api 时必填（任意 OpenAI 兼容端点）----
# base_url 形如 https://<服务商域名>/v1，不要带 /embeddings（代码会自己拼）
RAG_LAB_EMBEDDING_BASE_URL=
# 向量模型名：以服务商文档为准
RAG_LAB_EMBEDDING_MODEL=
# 0 表示"用第一条响应推断维度"；填了就会校验，不符直接报错（更安全）
RAG_LAB_EMBEDDING_DIM=0
# 只放在 .env 里，不要提交
RAG_LAB_EMBEDDING_API_KEY=

# ---- 可选 ----
# 每批请求多少条文本。默认 10 是保守值：多数国内服务商单请求上限就是 10 条
# （实测阿里云 text-embedding-v4：batch=32 会直接返回 HTTP 400 InvalidParameter）
RAG_LAB_EMBEDDING_BATCH_SIZE=10
RAG_LAB_EMBEDDING_TIMEOUT=30
# 429/5xx/超时的重试次数（鉴权与参数错误**不会**重试）
RAG_LAB_EMBEDDING_MAX_RETRIES=3

# RAG-04 检索时取前 K 条（本阶段未使用）
RAG_LAB_TOP_K=5
