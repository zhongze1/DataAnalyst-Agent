# ---- LLM 配置（OpenAI 兼容接口，改 base_url 即可切换厂商）----
# provider: openai = 真实模型；mock = 本地假模型（不联网，用于验证链路）
AGENT_LLM_PROVIDER=openai
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_TEMPERATURE=0

# ---- Agent 行为 ----
# 启动时配置校验不通过，是否直接拒绝启动（true=fail-fast，false=仅告警）
AGENT_STRICT_CONFIG=true
# 单次提问最多允许几轮「模型思考 + 工具调用」
AGENT_MAX_AGENT_STEPS=12
# 单次工具返回给模型的最大字符数
AGENT_MAX_TOOL_OUTPUT_CHARS=4000
# run_pandas 沙箱允许的最大代码行数
AGENT_MAX_SANDBOX_CODE_LINES=80

# ---- 审计 ----
# 工具调用审计（JSONL，按天切分）。只记参数形状不记内容。
AGENT_AUDIT_ENABLED=true

# ---- 认证 ----
# 关闭时免登录，仅供本机开发。生产环境务必开启。
AGENT_AUTH_ENABLED=true
# 首次启动自动创建该管理员（不提供开放注册）。留空则无法创建。
AGENT_AUTH_ADMIN_USERNAME=admin
AGENT_AUTH_ADMIN_PASSWORD=
# 登录态有效期（小时）
AGENT_SESSION_TTL_HOURS=12
# 走 HTTPS 时置 true，Cookie 才带 Secure 标记
AGENT_AUTH_COOKIE_SECURE=false

# ---- 上传限制 ----
AGENT_MAX_UPLOAD_BYTES=52428800

# ---- 知识库检索（DA-018）----
# 把 rag_lab 导出的工件注册成 Agent 工具 knowledge_search。
# 工件在 data/knowledge/，由 `uv run python -m rag_lab.export_index` 生成
# （data/* 不入库，所以新克隆的仓库要先跑一次导出，否则工具会报「未构建」）。
AGENT_KNOWLEDGE_ENABLED=true
# 返回条数默认值与上限（上限会写进工具 schema 的 maximum）
AGENT_KNOWLEDGE_TOP_K=5
AGENT_KNOWLEDGE_TOP_K_MAX=10
# 工具输出的整体预算与单条片段正文字数
AGENT_KNOWLEDGE_MAX_CHARS=2400
AGENT_KNOWLEDGE_SNIPPET_CHARS=300
# 两路最低分：低于它的片段不进榜，避免拿低分噪声编答案
AGENT_KNOWLEDGE_MIN_VECTOR_SCORE=0.35
AGENT_KNOWLEDGE_MIN_KEYWORD_SCORE=1.0

# ---- 查询向量化（可选）----
# 三项**要么都填**（走「向量 + 关键词」混合检索），**要么都留空**（纯关键词模式，
# 完全不需要向量服务）。只填一部分会被启动校验挡住。
# 任意 OpenAI 兼容端点都行，换服务商只改这三行。
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=
AGENT_EMBEDDING_TIMEOUT=15
AGENT_EMBEDDING_TRUST_ENV=true
